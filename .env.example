# Copy to .env.dev (or .env.local for personal overrides). Only this file is committed.

# dev | production | e2e. Selects which .env.* files are loaded; unset means dev.
NODE_ENV=dev

# HTTP port of the API.
PORT=3000

# PostgreSQL address (secret). Locally: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/kit_sandbox
# with the values from docker-compose.yml; on a stand — from the stand's secret store.
DATABASE_URL=

# debug | info | warn | error | silent
LOG_LEVEL=info
